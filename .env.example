OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V3
# 1 = offline demo (no external LLM). Set 0 and a reachable OPENAI_BASE_URL for real models.
MOCK_LLM=1
# Must match takeout-agent A2A_BEARER_TOKEN when calling takeout merchants over A2A v2.
A2A_BEARER_TOKEN=dev-a2a-secret-change-me
